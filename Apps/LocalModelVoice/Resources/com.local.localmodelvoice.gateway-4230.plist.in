<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.localmodelvoice.gateway-4230</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__SUPERVISOR_PATH__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>WorkingDirectory</key>
  <string>__SUPPORT_DIR__</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/localmodelvoice-gateway-4230.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/localmodelvoice-gateway-4230.err.log</string>
</dict>
</plist>
